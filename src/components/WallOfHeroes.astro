---
import Icon from './Icon.astro';
---

<section id="heroes" class="py-12 sm:py-16 bg-stone-50 dark:bg-stone-950 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-xl mx-auto mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-stone-200/80 dark:bg-stone-800 text-stone-700 dark:text-stone-300 mb-3">
        <Icon name="shield" class="w-3.5 h-3.5 text-stone-700 dark:text-stone-300" />
        <span>Wall of Heroes</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900 dark:text-white">
        Our Generous Supporters
      </h2>
      <p class="mt-2 text-stone-600 dark:text-stone-400 text-xs sm:text-sm">
        Every meal and sterilization is powered by your kindness. Anonymity is honored for all donors.
      </p>
    </div>

    <!-- Heroes Grid -->
    <div id="heroes-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 max-w-4xl mx-auto">
      <!-- Populated dynamically via client-side script from Supabase + local cache -->
    </div>

    <!-- View Full Leaderboard Button -->
    <div class="mt-8 text-center">
      <a 
        href="/leaderboard"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-300 transition-colors"
      >
        <span>View Full Ranked Leaderboard ({'>'})</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

  </div>
</section>

<script>
  import { supabase, DEMO_DONATIONS } from '../lib/supabase.js';

  async function loadHeroes() {
    const container = document.getElementById('heroes-list');
    if (!container) return;

    let donations = [...DEMO_DONATIONS];

    try {
      const local = JSON.parse(localStorage.getItem('fullora_local_donations') || '[]');
      if (local.length > 0) {
        donations = [...local, ...donations];
      }
    } catch (e) {}

    try {
      const { data } = await supabase
        .from('donations')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(9);

      if (data && data.length > 0) {
        donations = data;
      }
    } catch (e) {}

    container.innerHTML = donations.slice(0, 6).map((d: any) => `
      <div class="p-3.5 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-2xs flex items-center gap-3 hover:border-stone-400 dark:hover:border-stone-700 transition-all">
        <div class="w-9 h-9 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-600 dark:text-stone-300 flex items-center justify-center font-bold text-xs shrink-0">
          ${d.is_anonymous ? 'PAW' : (d.donor_name ? d.donor_name.charAt(0).toUpperCase() : 'G')}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-1">
            <h4 class="text-xs font-bold text-stone-900 dark:text-white truncate">
              ${d.donor_name || 'Anonymous Angel'}
            </h4>
            <span class="text-xs font-black text-emerald-700 dark:text-emerald-400 font-mono">
              ৳${Number(d.amount).toLocaleString()}
            </span>
          </div>
          <div class="flex items-center justify-between mt-0.5 text-[10px]">
            <span class="text-stone-500 capitalize">
              ${(d.donation_mode || 'general').replace('_', ' ')}
            </span>
            <span class="text-stone-400 font-mono">
              ${d.transaction_reference ? '#' + d.transaction_reference.slice(0, 8) : ''}
            </span>
          </div>
        </div>
      </div>
    `).join('');
  }

  loadHeroes();
</script>
