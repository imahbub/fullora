    <path d="M9 22v-4h6v4"/>
    <path d="M8 6h.01"/>
    <path d="M16 6h.01"/>
    <path d="M8 10h.01"/>
    <path d="M16 10h.01"/>
    <path d="M8 14h.01"/>
    <path d="M16 14h.01"/>
  </svg>
)}

{name === 'trophy' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
    <path d="M4 22h16"/>
    <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
    <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
    <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
  </svg>
)}

{name === 'cat' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 5c.67 0 1.35.09 2 .26 1.78-2 5.03-2.84 6.42-2.26 1.4.58-.42 7-.42 7A10 10 0 0 1 21 16c0 3.31-4.03 6-9 6s-9-2.69-9-6c0-2.22.68-4.25 1.9-5.74 0 0-1.82-6.42-.42-7 1.39-.58 4.64.26 6.42 2.26.68-.17 1.36-.26 2.1-.26Z"/>
    <path d="M9 14v.01"/>
    <path d="M15 14v.01"/>
  </svg>
)}

{name === 'dog' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10 5.172C10 3.782 8.423 2.679 6.5 3c-2.823.47-4.113 6.006-4 7 .105.92 1.382 1.5 2.5 1.5 1.5 0 2.2-.6 2.5-1.5.3-.9 1.5-1.328 2.5-1.328"/>
    <path d="M14 5.172C14 3.782 15.577 2.679 17.5 3c2.823.47 4.113 6.006 4 7-.105.92-1.382 1.5-2.5 1.5-1.5 0-2.2-.6-2.5-1.5-.3-.9-1.5-1.328-2.5-1.328"/>
    <path d="M8 14v.5"/>
    <path d="M16 14v.5"/>
    <path d="M11.25 16.25h1.5"/>
    <path d="M6 10a6 6 0 0 0 12 0"/>
  </svg>
)}

{name === 'syringe' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="m18 2 4 4"/>
    <path d="m17 7 3-3"/>
    <path d="M19 9 8.7 19.3c-.4.4-1 .6-1.7.6H3v-4c0-.7.2-1.3.6-1.7L14 3.9"/>
    <path d="m9 11 4 4"/>
    <path d="m5 19-3 3"/>
    <path d="m14 4 6 6"/>
  </svg>
)}

{name === 'bowl' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 21a9 9 0 0 0 9-9H3a9 9 0 0 0 9 9Z"/>
    <path d="M7 8V4"/>
    <path d="M12 8V2"/>
    <path d="M17 8V4"/>
  </svg>
)}

{name === 'home' && (
  <svg class={className} style={style} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
    <polyline points="9 22 9 12 15 12 15 22"/>
  </svg>
)}
