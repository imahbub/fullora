---
interface Props {
  goalAmount?: number;
  currentAmount?: number;
  spayedCount?: number;
  animalsCount?: number;
}

const {
  goalAmount = 100000,
  currentAmount = 64500,
  spayedCount = 28,
  animalsCount = 42
} = Astro.props;

const percentage = Math.min(100, Math.round((currentAmount / goalAmount) * 100));
---

<section id="progress" class="py-12 sm:py-16 bg-white dark:bg-stone-900/60 border-y border-stone-200/80 dark:border-stone-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 mb-3">
        <span>🐾 Shelter Happiness & Care Meter</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-white">
        Monthly Community Care Goal
      </h2>
      <p class="mt-2 text-stone-600 dark:text-stone-400 text-sm">
        Every single donation moves the paw forward. Help us fill the bowls, provide veterinary medicine, and sterilize stray dogs and cats.
      </p>
    </div>

    <!-- Main Gamified Progress Card -->
    <div class="relative max-w-4xl mx-auto p-6 sm:p-8 rounded-3xl bg-gradient-to-b from-stone-50 to-emerald-50/40 dark:from-stone-900 dark:to-emerald-950/20 border border-stone-200 dark:border-stone-800 shadow-sm">
      
      <!-- Top Numbers -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-4">
        <div>
          <span class="text-xs uppercase tracking-wider font-semibold text-stone-500 dark:text-stone-400">Total Funded This Month</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span class="text-3xl sm:text-4xl font-extrabold text-emerald-700 dark:text-emerald-400">
              ৳{currentAmount.toLocaleString()}
            </span>
            <span class="text-stone-500 dark:text-stone-400 text-sm font-medium">
              of ৳{goalAmount.toLocaleString()} target
            </span>
          </div>
        </div>

        <div class="inline-flex items-center gap-2 bg-white dark:bg-stone-800 px-4 py-2 rounded-2xl border border-stone-200 dark:border-stone-700 shadow-xs">
          <span class="text-xl">🏆</span>
          <div class="text-left">
            <div class="text-xs font-bold text-stone-900 dark:text-white">{percentage}% Achieved</div>
            <div class="text-[11px] text-stone-500 dark:text-stone-400">Keep the momentum going!</div>
          </div>
        </div>
      </div>

      <!-- Animated Progress Bar -->
      <div class="relative w-full h-5 bg-stone-200 dark:bg-stone-800 rounded-full overflow-hidden shadow-inner">
        <div 
          class="h-full bg-gradient-to-r from-emerald-500 via-teal-500 to-amber-500 rounded-full transition-all duration-1000 ease-out relative"
          style={`width: ${percentage}%`}
        >
          <!-- Shimmer effect -->
          <div class="absolute inset-0 badge-shimmer"></div>
        </div>
      </div>

      <!-- Milestones Indicators -->
      <div class="grid grid-cols-4 gap-2 mt-6 pt-4 border-t border-stone-200/60 dark:border-stone-800 text-center">
        <div class="flex flex-col items-center">
          <span class="text-lg sm:text-xl">🥣</span>
          <span class="text-[11px] sm:text-xs font-semibold text-stone-700 dark:text-stone-300 mt-1">25% Food Secured</span>
          <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">✓ Unlocked</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-lg sm:text-xl">💉</span>
          <span class="text-[11px] sm:text-xs font-semibold text-stone-700 dark:text-stone-300 mt-1">50% Vaccines</span>
          <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-medium">✓ Unlocked</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-lg sm:text-xl">✂️</span>
          <span class="text-[11px] sm:text-xs font-semibold text-stone-700 dark:text-stone-300 mt-1">75% Spay/Neuter</span>
          <span class="text-[10px] text-amber-600 dark:text-amber-400 font-medium">In Progress</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-lg sm:text-xl">🏠</span>
          <span class="text-[11px] sm:text-xs font-semibold text-stone-700 dark:text-stone-300 mt-1">100% Shelter Care</span>
          <span class="text-[10px] text-stone-400 dark:text-stone-500">Locked</span>
        </div>
      </div>

      <!-- Quick Action CTA -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <button
          onclick="window.openDonationModal({ mode: 'spay_neuter' })"
          class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all"
        >
          ✂️ Fund a Spay/Neuter (৳1,500)
        </button>
        <button
          onclick="window.openDonationModal({ mode: 'monthly' })"
          class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-stone-800 hover:bg-stone-100 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 border border-stone-200 dark:border-stone-700 shadow-sm transition-all"
        >
          🌟 Become a Monthly Guardian (৳1,000)
        </button>
      </div>

    </div>

    <!-- 3 Core Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto mt-8">
      <div class="p-5 rounded-2xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-center">
        <div class="text-2xl font-black text-stone-900 dark:text-white">{animalsCount}</div>
        <div class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">Shelter Resident Cats & Dogs</div>
      </div>
      <div class="p-5 rounded-2xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-center">
        <div class="text-2xl font-black text-emerald-600 dark:text-emerald-400">{spayedCount} Surgeries</div>
        <div class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">Funded Spay & Neuters This Year</div>
      </div>
      <div class="p-5 rounded-2xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-center">
        <div class="text-2xl font-black text-amber-600 dark:text-amber-400">100%</div>
        <div class="text-xs text-stone-500 dark:text-stone-400 mt-0.5">Manual Reference Audit & Verification</div>
      </div>
    </div>

  </div>
</section>
