---
import Icon from './Icon.astro';

interface Props {
  goalAmount?: number;
  currentAmount?: number;
  spayedCount?: number;
  animalsCount?: number;
}

const {
  goalAmount = 100000,
  currentAmount = 64500,
  spayedCount = 28,
  animalsCount = 42
} = Astro.props;

const percentage = Math.min(100, Math.round((currentAmount / goalAmount) * 100));
---

<section id="progress" class="py-12 sm:py-16 bg-white dark:bg-stone-900/60 border-y border-stone-200/80 dark:border-stone-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-700 mb-3">
        <Icon name="paw" class="w-3.5 h-3.5 text-emerald-700 dark:text-emerald-400" />
        <span>Monthly Operations Goal</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900 dark:text-white">
        Shelter Care Progress
      </h2>
      <p class="mt-2 text-stone-600 dark:text-stone-400 text-xs sm:text-sm leading-relaxed">
        Transparent community funding for daily food, vaccinations, medical surgeries, and shelter upkeep.
      </p>
    </div>

    <!-- Main Clean Progress Card -->
    <div class="relative max-w-3xl mx-auto p-6 sm:p-7 rounded-2xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs">
      
      <!-- Top Numbers -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-4">
        <div>
          <span class="text-[11px] uppercase tracking-wider font-bold text-stone-500 dark:text-stone-400">Total Funded This Month</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span class="text-3xl sm:text-4xl font-black text-stone-900 dark:text-white tracking-tight">
              ৳{currentAmount.toLocaleString()}
            </span>
            <span class="text-stone-500 dark:text-stone-400 text-xs font-semibold">
              of ৳{goalAmount.toLocaleString()} target
            </span>
          </div>
        </div>

        <div class="inline-flex items-center gap-2 bg-white dark:bg-stone-800 px-3.5 py-1.5 rounded-xl border border-stone-200 dark:border-stone-700 shadow-2xs">
          <Icon name="sparkles" class="w-4 h-4 text-emerald-700 dark:text-emerald-400" />
          <span class="text-xs font-bold text-stone-900 dark:text-white">{percentage}% Funded</span>
        </div>
      </div>

      <!-- Animated Progress Bar -->
      <div class="relative w-full h-3 bg-stone-200 dark:bg-stone-800 rounded-full overflow-hidden">
        <div 
          class="h-full bg-emerald-700 dark:bg-emerald-500 rounded-full transition-all duration-700 ease-out"
          style={`width: ${percentage}%`}
        ></div>
      </div>

      <!-- Milestones Indicators (Vector Icons, No Emojis) -->
      <div class="grid grid-cols-4 gap-2 mt-6 pt-4 border-t border-stone-200/80 dark:border-stone-800 text-center">
        <div class="flex flex-col items-center">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center">
            <Icon name="bowl" class="w-4 h-4" />
          </div>
          <span class="text-[11px] font-bold text-stone-800 dark:text-stone-200 mt-1.5">Food Bowls</span>
          <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-semibold">Unlocked</span>
        </div>

        <div class="flex flex-col items-center">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center">
            <Icon name="syringe" class="w-4 h-4" />
          </div>
          <span class="text-[11px] font-bold text-stone-800 dark:text-stone-200 mt-1.5">Vaccines</span>
          <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-semibold">Unlocked</span>
        </div>

        <div class="flex flex-col items-center">
          <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 flex items-center justify-center">
            <Icon name="scissors" class="w-4 h-4" />
          </div>
          <span class="text-[11px] font-bold text-stone-800 dark:text-stone-200 mt-1.5">Sterilization</span>
          <span class="text-[10px] text-amber-700 dark:text-amber-400 font-semibold">In Progress</span>
        </div>

        <div class="flex flex-col items-center">
          <div class="w-8 h-8 rounded-lg bg-stone-100 dark:bg-stone-800 text-stone-400 flex items-center justify-center">
            <Icon name="home" class="w-4 h-4" />
          </div>
          <span class="text-[11px] font-bold text-stone-500 dark:text-stone-400 mt-1.5">Shelter Care</span>
          <span class="text-[10px] text-stone-400">Target</span>
        </div>
      </div>

      <!-- Quick Action CTA -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
        <button
          onclick="window.openDonationModal({ mode: 'spay_neuter' })"
          class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-700 hover:bg-amber-800 text-white shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center gap-1.5"
        >
          <Icon name="scissors" class="w-3.5 h-3.5" />
          <span>Fund a Spay/Neuter (৳1,500)</span>
        </button>
        <button
          onclick="window.openDonationModal({ mode: 'once' })"
          class="px-4 py-2 rounded-xl text-xs font-bold bg-white dark:bg-stone-800 hover:bg-stone-100 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 border border-stone-200 dark:border-stone-700 shadow-2xs hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center gap-1.5"
        >
          <Icon name="heart" class="w-3.5 h-3.5 text-stone-400" />
          <span>Become a Guardian (৳1,000/mo)</span>
        </button>
      </div>

    </div>

    <!-- 3 Clean Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto mt-6">
      <div class="p-4 rounded-xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-center">
        <div class="text-xl font-black text-stone-900 dark:text-white">{animalsCount}</div>
        <div class="text-[11px] text-stone-500 dark:text-stone-400 mt-0.5 font-medium">Resident Dogs & Cats</div>
      </div>
      <div class="p-4 rounded-xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-center">
        <div class="text-xl font-black text-emerald-700 dark:text-emerald-400">{spayedCount} Surgeries</div>
        <div class="text-[11px] text-stone-500 dark:text-stone-400 mt-0.5 font-medium">Sterilizations Completed</div>
      </div>
      <div class="p-4 rounded-xl bg-stone-50 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-center">
        <div class="text-xl font-black text-stone-900 dark:text-white">100% Audited</div>
        <div class="text-[11px] text-stone-500 dark:text-stone-400 mt-0.5 font-medium">Manual Reference Verification</div>
      </div>
    </div>

  </div>
</section>
