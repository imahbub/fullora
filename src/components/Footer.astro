---
import Icon from './Icon.astro';

interface Props {
  shelterName?: string;
}

const { shelterName = "Fullora's Shelter" } = Astro.props;
---

<footer class="bg-stone-100 dark:bg-stone-900 border-t border-stone-200 dark:border-stone-800 transition-colors py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-emerald-700 flex items-center justify-center text-white">
            <Icon name="paw" class="w-4 h-4 text-white" />
          </div>
          <span class="font-bold text-base text-stone-900 dark:text-white">{shelterName}</span>
        </div>
        <p class="text-xs text-stone-600 dark:text-stone-400 max-w-sm leading-relaxed">
          Dedicated to rescuing, rehabilitating, and spaying/neutering stray and abandoned cats and dogs in Bangladesh.
        </p>
        <div class="flex items-center gap-2 text-xs text-stone-500 font-medium pt-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
          <span>100% Non-Profit Community Initiative</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-stone-900 dark:text-stone-200">Get Involved</h4>
        <ul class="space-y-2 text-sm text-stone-600 dark:text-stone-400">
          <li><a href="/animals" class="hover:text-emerald-600 dark:hover:text-emerald-400">Meet Our Animals</a></li>
          <li><button onclick="window.openDonationModal({ mode: 'spay_neuter' })" class="hover:text-emerald-600 dark:hover:text-emerald-400 text-left">Fund a Spay/Neuter</button></li>
          <li><button onclick="window.openDonationModal({ mode: 'sponsor' })" class="hover:text-emerald-600 dark:hover:text-emerald-400 text-left">Sponsor Monthly</button></li>
          <li><a href="/#heroes" class="hover:text-emerald-600 dark:hover:text-emerald-400">Wall of Heroes</a></li>
        </ul>
      </div>

      <!-- Emergency / Transparency -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-stone-900 dark:text-stone-200">Transparency</h4>
        <p class="text-xs text-stone-500 dark:text-stone-400">
          We manually audit and verify every transaction reference submitted through our platform to guarantee accountability.
        </p>
        <div class="pt-2">
          <a href="/admin" class="inline-flex items-center gap-1.5 text-xs text-stone-500 hover:text-stone-800 dark:hover:text-stone-200 transition-colors">
            <span>Shelter Admin Login</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <div class="mt-8 pt-6 border-t border-stone-200 dark:border-stone-800 text-center text-xs text-stone-500 dark:text-stone-500">
      <p>&copy; {new Date().getFullYear()} {shelterName}. Made with love for all paws & whiskers.</p>
    </div>
  </div>
</footer>
