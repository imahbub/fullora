---
import Icon from './Icon.astro';
---

<div id="donation-modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-stone-950/70 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 transition-all duration-200">
  
  <div class="relative w-full max-w-md bg-white dark:bg-stone-900 rounded-2xl shadow-xl border border-stone-200 dark:border-stone-800 overflow-hidden text-stone-800 dark:text-stone-100 my-4 transition-all">
    
    <!-- Modal Header (Clean & Minimalist) -->
    <div class="px-5 py-4 border-b border-stone-100 dark:border-stone-800 flex items-center justify-between bg-stone-50/50 dark:bg-stone-900/50">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center">
          <Icon name="heart" class="w-4 h-4" />
        </div>
        <div>
          <h3 class="font-bold text-sm text-stone-900 dark:text-white leading-tight">Support Fullora Shelter</h3>
          <p class="text-[11px] text-stone-500 dark:text-stone-400">Direct rescue, food & sterilization</p>
        </div>
      </div>
      
      <button 
        onclick="window.closeDonationModal()"
        aria-label="Close modal"
        class="w-7 h-7 rounded-lg text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 hover:bg-stone-100 dark:hover:bg-stone-800 flex items-center justify-center transition-colors text-xs font-semibold"
      >
        ✕
      </button>
    </div>

    <!-- Wizard Step Progress Bar -->
    <div class="px-5 pt-3 pb-2 flex items-center justify-between text-[11px] font-semibold border-b border-stone-100 dark:border-stone-800/60 bg-stone-50/30 dark:bg-stone-900/20">
      <div class="flex items-center gap-1.5" id="step-indicator-1">
        <span class="w-5 h-5 rounded-full bg-emerald-700 text-white flex items-center justify-center text-[10px] font-bold">1</span>
        <span class="text-stone-800 dark:text-stone-200">Cause & Amount</span>
      </div>
      <div class="w-6 h-px bg-stone-200 dark:bg-stone-800"></div>
      <div class="flex items-center gap-1.5 opacity-40" id="step-indicator-2">
        <span class="w-5 h-5 rounded-full bg-stone-200 dark:bg-stone-800 text-stone-600 dark:text-stone-300 flex items-center justify-center text-[10px] font-bold">2</span>
        <span class="text-stone-600 dark:text-stone-400">Payment</span>
      </div>
      <div class="w-6 h-px bg-stone-200 dark:bg-stone-800"></div>
      <div class="flex items-center gap-1.5 opacity-40" id="step-indicator-3">
        <span class="w-5 h-5 rounded-full bg-stone-200 dark:bg-stone-800 text-stone-600 dark:text-stone-300 flex items-center justify-center text-[10px] font-bold">3</span>
        <span class="text-stone-600 dark:text-stone-400">Confirm</span>
      </div>
    </div>

    <!-- Wizard Container -->
    <div class="p-5">

      <!-- ============================================== -->
      <!-- STEP 1: CAUSE & AMOUNT -->
      <!-- ============================================== -->
      <div id="wizard-step-1" class="space-y-4">
        
        <!-- Cause Cards -->
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-2">
            Select Donation Type
          </label>
          <div class="grid grid-cols-3 gap-2">
            <button 
              type="button" 
              id="wizard-tab-once" 
              onclick="window.switchDonationMode('once')" 
              class="p-2.5 rounded-xl border text-left transition-all duration-150 flex flex-col justify-between border-emerald-700 bg-emerald-50/60 dark:bg-emerald-950/40 text-stone-900 dark:text-white"
            >
              <Icon name="heart" class="w-4 h-4 text-emerald-700 dark:text-emerald-400 mb-1.5" />
              <div>
                <div class="text-xs font-bold leading-tight">Food & Care</div>
                <div class="text-[10px] text-stone-500 dark:text-stone-400">General fund</div>
              </div>
            </button>

            <button 
              type="button" 
              id="wizard-tab-sponsor" 
              onclick="window.switchDonationMode('sponsor')" 
              class="p-2.5 rounded-xl border text-left transition-all duration-150 flex flex-col justify-between border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-800/40 text-stone-700 dark:text-stone-300"
            >
              <Icon name="paw" class="w-4 h-4 text-stone-500 dark:text-stone-400 mb-1.5" />
              <div>
                <div class="text-xs font-bold leading-tight">Sponsor Pet</div>
                <div class="text-[10px] text-stone-500 dark:text-stone-400">Choose dog/cat</div>
              </div>
            </button>

            <button 
              type="button" 
              id="wizard-tab-spay_neuter" 
              onclick="window.switchDonationMode('spay_neuter')" 
              class="p-2.5 rounded-xl border text-left transition-all duration-150 flex flex-col justify-between border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-800/40 text-stone-700 dark:text-stone-300"
            >
              <Icon name="scissors" class="w-4 h-4 text-stone-500 dark:text-stone-400 mb-1.5" />
              <div>
                <div class="text-xs font-bold leading-tight">Spay/Neuter</div>
                <div class="text-[10px] text-stone-500 dark:text-stone-400">Sterilization</div>
              </div>
            </button>
          </div>
        </div>

        <!-- Animal Dropdown (shown for sponsor or spay_neuter) -->
        <div id="modal-animal-container" class="hidden">
          <label class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1.5">
            Select Resident Animal
          </label>
          <select 
            id="animal-select" 
            class="w-full px-3 py-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-xs text-stone-900 dark:text-stone-100 outline-hidden focus:ring-1 focus:ring-emerald-600"
          >
            <option value="">General Sanctuary Care (All Residents)</option>
          </select>
        </div>

        <!-- Frequency Toggle (One-time vs Monthly) -->
        <div id="frequency-container" class="flex items-center gap-2 p-1 bg-stone-100 dark:bg-stone-800/80 rounded-xl text-xs font-semibold">
          <button 
            type="button" 
            id="freq-btn-once" 
            onclick="window.setFrequency('once')" 
            class="flex-1 py-1.5 rounded-lg bg-white dark:bg-stone-900 text-stone-900 dark:text-white shadow-xs transition-all text-center"
          >
            One-Time
          </button>
          <button 
            type="button" 
            id="freq-btn-monthly" 
            onclick="window.setFrequency('monthly')" 
            class="flex-1 py-1.5 rounded-lg text-stone-500 dark:text-stone-400 transition-all text-center"
          >
            Monthly Sustainer
          </button>
        </div>

        <!-- Amount Chips -->
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1.5">
            Donation Amount (BDT ৳)
          </label>
          <div class="grid grid-cols-4 gap-2 mb-2.5">
            <button type="button" onclick="window.selectAmount(500)" class="amt-chip py-2 rounded-xl text-xs font-bold border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 hover:border-emerald-600 transition-colors">৳500</button>
            <button type="button" onclick="window.selectAmount(1000)" class="amt-chip py-2 rounded-xl text-xs font-bold border border-emerald-700 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300">৳1,000</button>
            <button type="button" onclick="window.selectAmount(1500)" class="amt-chip py-2 rounded-xl text-xs font-bold border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 hover:border-emerald-600 transition-colors">৳1,500</button>
            <button type="button" onclick="window.selectAmount(3000)" class="amt-chip py-2 rounded-xl text-xs font-bold border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 hover:border-emerald-600 transition-colors">৳3,000</button>
          </div>
          <div class="relative">
            <span class="absolute left-3 top-2.5 text-xs font-bold text-stone-400">৳</span>
            <input 
              type="number" 
              id="custom-amount-input" 
              value="1000" 
              min="100" 
              placeholder="Other amount" 
              class="w-full pl-7 pr-3 py-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-xs font-bold outline-hidden focus:ring-1 focus:ring-emerald-600"
            />
          </div>
        </div>

        <button 
          type="button" 
          onclick="window.goToStep(2)"
          class="w-full py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500 shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-1.5"
        >
          <span>Continue to Payment</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </button>
      </div>

      <!-- ============================================== -->
      <!-- STEP 2: PAYMENT CHANNEL & ACCOUNT COPY -->
      <!-- ============================================== -->
      <div id="wizard-step-2" class="hidden space-y-4">
        
        <!-- Payment Toggle -->
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-2">
            Select Payment Method
          </label>
          <div class="grid grid-cols-2 gap-2">
            <button 
              type="button" 
              id="btn-method-mfs" 
              onclick="window.switchPaymentMethod('mfs')"
              class="p-2.5 rounded-xl border text-left flex items-center gap-2.5 transition-all border-emerald-700 bg-emerald-50/60 dark:bg-emerald-950/40"
            >
              <Icon name="phone" class="w-4 h-4 text-emerald-700 dark:text-emerald-400 shrink-0" />
              <div>
                <div class="text-xs font-bold text-stone-900 dark:text-white">Mobile Wallet</div>
                <div class="text-[10px] text-stone-500 dark:text-stone-400">bKash, Nagad, Rocket</div>
              </div>
            </button>

            <button 
              type="button" 
              id="btn-method-bank" 
              onclick="window.switchPaymentMethod('bank')"
              class="p-2.5 rounded-xl border text-left flex items-center gap-2.5 transition-all border-stone-200 dark:border-stone-800 bg-stone-50/50 dark:bg-stone-800/40"
            >
              <Icon name="building" class="w-4 h-4 text-stone-400 shrink-0" />
              <div>
                <div class="text-xs font-bold text-stone-900 dark:text-white">Bank Transfer</div>
                <div class="text-[10px] text-stone-500 dark:text-stone-400">Direct Deposit / BEFTN</div>
              </div>
            </button>
          </div>
        </div>

        <!-- MFS Account Copy Box -->
        <div id="box-mfs-details" class="p-3.5 rounded-2xl bg-stone-50 dark:bg-stone-800/60 border border-stone-200 dark:border-stone-700/80 space-y-2">
          <div class="text-[11px] font-semibold text-stone-600 dark:text-stone-400 flex items-center justify-between">
            <span>Send Money to official shelter number:</span>
            <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-bold">Tap to copy</span>
          </div>

          <div class="space-y-1.5">
            <!-- bKash -->
            <div class="flex items-center justify-between p-2 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-xs">
              <span class="font-bold text-pink-600">bKash (Personal)</span>
              <div class="flex items-center gap-1.5 font-mono font-bold text-stone-900 dark:text-stone-100">
                <span id="bkash-num">01712-345678</span>
                <button type="button" onclick="window.copyText('01712345678', this)" class="p-1 rounded-md hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-400 hover:text-emerald-600 transition-colors" title="Copy Number">
                  <Icon name="copy" class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>

            <!-- Nagad -->
            <div class="flex items-center justify-between p-2 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-xs">
              <span class="font-bold text-orange-600">Nagad (Personal)</span>
              <div class="flex items-center gap-1.5 font-mono font-bold text-stone-900 dark:text-stone-100">
                <span id="nagad-num">01812-345678</span>
                <button type="button" onclick="window.copyText('01812345678', this)" class="p-1 rounded-md hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-400 hover:text-emerald-600 transition-colors" title="Copy Number">
                  <Icon name="copy" class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>

            <!-- Rocket -->
            <div class="flex items-center justify-between p-2 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-xs">
              <span class="font-bold text-purple-600">Rocket (Personal)</span>
              <div class="flex items-center gap-1.5 font-mono font-bold text-stone-900 dark:text-stone-100">
                <span id="rocket-num">01912-345678-9</span>
                <button type="button" onclick="window.copyText('019123456789', this)" class="p-1 rounded-md hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-400 hover:text-emerald-600 transition-colors" title="Copy Number">
                  <Icon name="copy" class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Bank Details Box -->
        <div id="box-bank-details" class="hidden p-3.5 rounded-2xl bg-stone-50 dark:bg-stone-800/60 border border-stone-200 dark:border-stone-700/80 space-y-2 text-xs">
          <div class="text-[11px] font-semibold text-stone-600 dark:text-stone-400">
            Shelter Official Bank Account:
          </div>
          <div class="p-2.5 rounded-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 space-y-1">
            <div class="flex justify-between">
              <span class="text-stone-500">Bank:</span>
              <span class="font-bold text-stone-900 dark:text-stone-100" id="bank-name-val">City Bank PLC</span>
            </div>
            <div class="flex justify-between">
              <span class="text-stone-500">Account Name:</span>
              <span class="font-semibold text-stone-900 dark:text-stone-100" id="bank-acc-name-val">Fullora Animal Sanctuary</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-stone-500">Account No:</span>
              <div class="flex items-center gap-1.5 font-mono font-bold text-emerald-700 dark:text-emerald-400">
                <span id="bank-acc-num-val">11029384756</span>
                <button type="button" onclick="window.copyText('11029384756', this)" class="p-1 rounded-md hover:bg-stone-100 dark:hover:bg-stone-800 text-stone-400 hover:text-emerald-600 transition-colors">
                  <Icon name="copy" class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2 Navigation Buttons -->
        <div class="flex items-center gap-2 pt-1">
          <button 
            type="button" 
            onclick="window.goToStep(1)"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors flex items-center gap-1"
          >
            <Icon name="arrow-left" class="w-3.5 h-3.5" />
            <span>Back</span>
          </button>
          
          <button 
            type="button" 
            onclick="window.goToStep(3)"
            class="flex-1 py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500 shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-1.5"
          >
            <span>I Have Sent the Money &rarr;</span>
          </button>
        </div>

      </div>

      <!-- ============================================== -->
      <!-- STEP 3: TRANSACTION ID & CONFIRM -->
      <!-- ============================================== -->
      <div id="wizard-step-3" class="hidden space-y-4">
        
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1" id="wizard-sender-label">
            Your Wallet Number (Sent From) *
          </label>
          <input 
            type="text" 
            id="wizard-sender-input" 
            placeholder="e.g. 01712-XXXXXX" 
            required
            class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-xs font-mono outline-hidden focus:ring-1 focus:ring-emerald-600"
          />
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1">
            Transaction ID / Deposit Reference (TrxID) *
          </label>
          <input 
            type="text" 
            id="wizard-trx-input" 
            placeholder="e.g. 9K28JA71B" 
            required
            class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-xs font-mono font-bold uppercase outline-hidden focus:ring-1 focus:ring-emerald-600"
          />
        </div>

        <!-- Anonymous Checkbox -->
        <div class="p-3 rounded-xl bg-stone-50 dark:bg-stone-800/40 border border-stone-200 dark:border-stone-800 space-y-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input 
              type="checkbox" 
              id="wizard-anon-checkbox" 
              checked 
              onchange="window.toggleWizardAnon(this.checked)"
              class="w-4 h-4 rounded text-emerald-700 focus:ring-emerald-600 cursor-pointer"
            />
            <span class="text-xs font-medium text-stone-800 dark:text-stone-200">
              Donate Anonymously (No account or name required)
            </span>
          </label>

          <div id="wizard-profile-fields" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
            <input 
              type="text" 
              id="wizard-name-input" 
              placeholder="Your Name / Nickname" 
              class="w-full px-3 py-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 text-xs outline-hidden"
            />
            <input 
              type="email" 
              id="wizard-email-input" 
              placeholder="Email (for updates)" 
              class="w-full px-3 py-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 text-xs outline-hidden"
            />
          </div>
        </div>

        <!-- Step 3 Navigation Buttons -->
        <div class="flex items-center gap-2 pt-1">
          <button 
            type="button" 
            onclick="window.goToStep(2)"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors flex items-center gap-1"
          >
            <Icon name="arrow-left" class="w-3.5 h-3.5" />
            <span>Back</span>
          </button>
          
          <button 
            type="button" 
            id="wizard-submit-btn"
            onclick="window.handleWizardSubmit()"
            class="flex-1 py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 dark:bg-emerald-600 dark:hover:bg-emerald-500 shadow-xs hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-1.5"
          >
            <Icon name="check" class="w-4 h-4" />
            <span>Complete Donation</span>
          </button>
        </div>

      </div>

      <!-- ============================================== -->
      <!-- SUCCESS & CELEBRATION SCREEN -->
      <!-- ============================================== -->
      <div id="wizard-celebration" class="hidden text-center py-4 space-y-4">
        
        <div class="w-12 h-12 mx-auto rounded-2xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-400 flex items-center justify-center shadow-xs">
          <Icon name="sparkles" class="w-6 h-6" />
        </div>

        <div>
          <h4 class="text-lg font-extrabold text-stone-900 dark:text-white">Thank You for Caring</h4>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-1 max-w-xs mx-auto">
            Your transaction reference has been recorded for shelter audit.
          </p>
        </div>

        <!-- Minimalist Impact Card -->
        <div class="p-4 rounded-2xl bg-stone-50 dark:bg-stone-800/60 border border-stone-200 dark:border-stone-700/80 text-left text-xs space-y-2">
          <div class="flex items-center justify-between border-b border-stone-200/60 dark:border-stone-700 pb-2">
            <span class="text-stone-500">Supporter:</span>
            <span class="font-bold text-stone-900 dark:text-white" id="success-donor-name">Anonymous Angel</span>
          </div>
          <div class="flex items-center justify-between border-b border-stone-200/60 dark:border-stone-700 pb-2">
            <span class="text-stone-500">Amount & Cause:</span>
            <span class="font-bold text-emerald-700 dark:text-emerald-400" id="success-amount">৳1,000</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-stone-500">Reference:</span>
            <span class="font-mono font-bold text-stone-700 dark:text-stone-300" id="success-trx">9K28JA71B</span>
          </div>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <button 
            type="button" 
            onclick="window.closeDonationModal(); location.reload();"
            class="flex-1 py-2.5 rounded-xl text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800"
          >
            View on Wall of Heroes
          </button>
          <button 
            type="button" 
            onclick="window.closeDonationModal()"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300"
          >
            Done
          </button>
        </div>

      </div>

    </div>

  </div>
</div>

<script>
  import confetti from 'canvas-confetti';
  import { supabase, DEMO_DONATIONS } from '../lib/supabase.js';

  let currentStep = 1;
  let currentMode = 'once';
  let currentMethod = 'mfs';
  let currentFrequency = 'once';
  let selectedAnimalId = '';
  let selectedAnimalName = '';

  window.openDonationModal = function(options = {}) {
    const modal = document.getElementById('donation-modal');
    modal?.classList.remove('hidden');

    // Populate shelter payment settings
    try {
      const saved = JSON.parse(localStorage.getItem('fullora_shelter_settings') || '{}');
      if (saved.bkash) {
        const bk = document.getElementById('bkash-num');
        if (bk) bk.textContent = saved.bkash;
      }
      if (saved.nagad) {
        const ng = document.getElementById('nagad-num');
        if (ng) ng.textContent = saved.nagad;
      }
      if (saved.rocket) {
        const rk = document.getElementById('rocket-num');
        if (rk) rk.textContent = saved.rocket;
      }
      if (saved.bankName) {
        const bn = document.getElementById('bank-name-val');
        if (bn) bn.textContent = saved.bankName;
      }
      if (saved.bankAccName) {
        const ban = document.getElementById('bank-acc-name-val');
        if (ban) ban.textContent = saved.bankAccName;
      }
      if (saved.bankAccNum) {
        const bac = document.getElementById('bank-acc-num-val');
        if (bac) bac.textContent = saved.bankAccNum;
      }
    } catch (e) {}

    // Populate animals into dropdown
    try {
      const animalSelect = document.getElementById('animal-select') as HTMLSelectElement;
      if (animalSelect) {
        let list = [...(window.shelterAnimalsList || [])];
        const local = JSON.parse(localStorage.getItem('fullora_local_animals') || '[]');
        if (local.length > 0) {
          const ids = new Set(local.map((a: any) => a.id));
          list = [...local, ...list.filter(a => !ids.has(a.id))];
        }
        if (list.length > 0) {
          animalSelect.innerHTML = '<option value="">General Sanctuary Care (All Residents)</option>' +
            list.map((a: any) => `<option value="${a.id}">${a.name} (${a.species === 'cat' ? 'Cat' : 'Dog'}${a.needs_spay_neuter ? ' • Needs Spaying' : ''})</option>`).join('');
        }
      }
    } catch (e) {}

    if (options.mode) {
      window.switchDonationMode(options.mode);
    }
    if (options.animalId) {
      selectedAnimalId = options.animalId;
      selectedAnimalName = options.animalName || '';
      const select = document.getElementById('animal-select') as HTMLSelectElement;
      if (select) select.value = options.animalId;
    }
    if (options.amount) {
      window.selectAmount(options.amount);
    }

    window.goToStep(1);
  };

  window.closeDonationModal = function() {
    document.getElementById('donation-modal')?.classList.add('hidden');
  };

  window.goToStep = function(step: number) {
    currentStep = step;
    
    // Hide all steps
    document.getElementById('wizard-step-1')?.classList.add('hidden');
    document.getElementById('wizard-step-2')?.classList.add('hidden');
    document.getElementById('wizard-step-3')?.classList.add('hidden');
    document.getElementById('wizard-celebration')?.classList.add('hidden');

    // Show current step
    document.getElementById(`wizard-step-${step}`)?.classList.remove('hidden');

    // Update step indicator
    for (let i = 1; i <= 3; i++) {
      const ind = document.getElementById(`step-indicator-${i}`);
      const circle = ind?.querySelector('span:first-child');
      if (i === step) {
        ind?.classList.remove('opacity-40');
        circle?.classList.remove('bg-stone-200', 'dark:bg-stone-800', 'text-stone-600', 'dark:text-stone-300');
        circle?.classList.add('bg-emerald-700', 'text-white');
      } else if (i < step) {
        ind?.classList.remove('opacity-40');
        circle?.classList.remove('bg-stone-200', 'dark:bg-stone-800', 'text-stone-600', 'dark:text-stone-300');
        circle?.classList.add('bg-emerald-700/80', 'text-white');
      } else {
        ind?.classList.add('opacity-40');
        circle?.classList.remove('bg-emerald-700', 'bg-emerald-700/80', 'text-white');
        circle?.classList.add('bg-stone-200', 'dark:bg-stone-800', 'text-stone-600', 'dark:text-stone-300');
      }
    }
  };

  window.switchDonationMode = function(mode: string) {
    currentMode = mode;
    const tabs = ['once', 'sponsor', 'spay_neuter'];
    tabs.forEach(t => {
      const el = document.getElementById(`wizard-tab-${t}`);
      if (t === mode) {
        el?.classList.add('border-emerald-700', 'bg-emerald-50/60', 'dark:bg-emerald-950/40', 'text-stone-900', 'dark:text-white');
        el?.classList.remove('border-stone-200', 'dark:border-stone-800', 'bg-stone-50/50', 'dark:bg-stone-800/40', 'text-stone-700', 'dark:text-stone-300');
      } else {
        el?.classList.remove('border-emerald-700', 'bg-emerald-50/60', 'dark:bg-emerald-950/40', 'text-stone-900', 'dark:text-white');
        el?.classList.add('border-stone-200', 'dark:border-stone-800', 'bg-stone-50/50', 'dark:bg-stone-800/40', 'text-stone-700', 'dark:text-stone-300');
      }
    });

    const animalContainer = document.getElementById('modal-animal-container');
    const freqContainer = document.getElementById('frequency-container');

    const saved = JSON.parse(localStorage.getItem('fullora_shelter_settings') || '{}');
    const spayCost = saved.spayCost ? parseFloat(saved.spayCost) : 1500;
    const sponsorCost = saved.sponsorCost ? parseFloat(saved.sponsorCost) : 1000;

    if (mode === 'sponsor' || mode === 'spay_neuter') {
      animalContainer?.classList.remove('hidden');
      freqContainer?.classList.add('hidden');
      if (mode === 'spay_neuter') {
        window.selectAmount(spayCost);
      } else {
        window.selectAmount(sponsorCost);
      }
    } else {
      animalContainer?.classList.add('hidden');
      freqContainer?.classList.remove('hidden');
    }
  };

  window.setFrequency = function(freq: string) {
    currentFrequency = freq;
    const onceBtn = document.getElementById('freq-btn-once');
    const monthlyBtn = document.getElementById('freq-btn-monthly');

    if (freq === 'once') {
      onceBtn?.classList.add('bg-white', 'dark:bg-stone-900', 'text-stone-900', 'dark:text-white', 'shadow-xs');
      onceBtn?.classList.remove('text-stone-500', 'dark:text-stone-400');
      monthlyBtn?.classList.remove('bg-white', 'dark:bg-stone-900', 'text-stone-900', 'dark:text-white', 'shadow-xs');
      monthlyBtn?.classList.add('text-stone-500', 'dark:text-stone-400');
    } else {
      monthlyBtn?.classList.add('bg-white', 'dark:bg-stone-900', 'text-stone-900', 'dark:text-white', 'shadow-xs');
      monthlyBtn?.classList.remove('text-stone-500', 'dark:text-stone-400');
      onceBtn?.classList.remove('bg-white', 'dark:bg-stone-900', 'text-stone-900', 'dark:text-white', 'shadow-xs');
      onceBtn?.classList.add('text-stone-500', 'dark:text-stone-400');
    }
  };

  window.selectAmount = function(amt: number) {
    const input = document.getElementById('custom-amount-input') as HTMLInputElement;
    if (input) input.value = amt.toString();
  };

  window.switchPaymentMethod = function(method: string) {
    currentMethod = method;
    const mfsBtn = document.getElementById('btn-method-mfs');
    const bankBtn = document.getElementById('btn-method-bank');
    const mfsBox = document.getElementById('box-mfs-details');
    const bankBox = document.getElementById('box-bank-details');
    const senderLabel = document.getElementById('wizard-sender-label');
    const senderInput = document.getElementById('wizard-sender-input') as HTMLInputElement;

    if (method === 'mfs') {
      mfsBtn?.classList.add('border-emerald-700', 'bg-emerald-50/60', 'dark:bg-emerald-950/40');
      mfsBtn?.classList.remove('border-stone-200', 'dark:border-stone-800', 'bg-stone-50/50', 'dark:bg-stone-800/40');
      bankBtn?.classList.remove('border-emerald-700', 'bg-emerald-50/60', 'dark:bg-emerald-950/40');
      bankBtn?.classList.add('border-stone-200', 'dark:border-stone-800', 'bg-stone-50/50', 'dark:bg-stone-800/40');
      mfsBox?.classList.remove('hidden');
      bankBox?.classList.add('hidden');
      if (senderLabel) senderLabel.textContent = "Your Wallet Number (Sent From) *";
      if (senderInput) senderInput.placeholder = "e.g. 01712-XXXXXX";
    } else {
      bankBtn?.classList.add('border-emerald-700', 'bg-emerald-50/60', 'dark:bg-emerald-950/40');
      bankBtn?.classList.remove('border-stone-200', 'dark:border-stone-800', 'bg-stone-50/50', 'dark:bg-stone-800/40');
      mfsBtn?.classList.remove('border-emerald-700', 'bg-emerald-50/60', 'dark:bg-emerald-950/40');
      mfsBtn?.classList.add('border-stone-200', 'dark:border-stone-800', 'bg-stone-50/50', 'dark:bg-stone-800/40');
      bankBox?.classList.remove('hidden');
      mfsBox?.classList.add('hidden');
      if (senderLabel) senderLabel.textContent = "Your Bank Name & Account Number *";
      if (senderInput) senderInput.placeholder = "e.g. City Bank - 110XXXXXX";
    }
  };

  window.copyText = function(text: string, btn: HTMLElement) {
    navigator.clipboard.writeText(text);
    const original = btn.innerHTML;
    btn.innerHTML = '<span class="text-emerald-600 font-bold text-[10px]">Copied!</span>';
    setTimeout(() => {
      btn.innerHTML = original;
    }, 1500);
  };

  window.toggleWizardAnon = function(isAnon: boolean) {
    const fields = document.getElementById('wizard-profile-fields');
    if (isAnon) {
      fields?.classList.add('hidden');
    } else {
      fields?.classList.remove('hidden');
    }
  };

  window.handleWizardSubmit = async function() {
    const sender = (document.getElementById('wizard-sender-input') as HTMLInputElement)?.value?.trim();
    const trx = (document.getElementById('wizard-trx-input') as HTMLInputElement)?.value?.trim();
    const amount = parseFloat((document.getElementById('custom-amount-input') as HTMLInputElement)?.value || '1000');
    const isAnon = (document.getElementById('wizard-anon-checkbox') as HTMLInputElement)?.checked ?? true;
    const donorName = isAnon ? 'Anonymous Angel' : ((document.getElementById('wizard-name-input') as HTMLInputElement)?.value?.trim() || 'Anonymous Angel');
    const donorEmail = isAnon ? null : ((document.getElementById('wizard-email-input') as HTMLInputElement)?.value?.trim() || null);
    const animalId = (document.getElementById('animal-select') as HTMLSelectElement)?.value || null;

    if (!sender) {
      alert("Please enter the number or bank account you sent the donation from.");
      (document.getElementById('wizard-sender-input') as HTMLInputElement)?.focus();
      return;
    }

    if (!trx) {
      alert("Please enter your Transaction ID (TrxID) or Reference number.");
      (document.getElementById('wizard-trx-input') as HTMLInputElement)?.focus();
      return;
    }

    const submitBtn = document.getElementById('wizard-submit-btn');
    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = 'Submitting...';
    }

    const donationData = {
      id: 'local-' + Date.now(),
      donation_mode: currentMode,
      animal_id: animalId,
      amount: amount,
      currency: 'BDT',
      payment_type: currentMethod,
      sender_wallet_or_account: sender,
      transaction_reference: trx,
      donor_name: donorName,
      donor_email: donorEmail,
      is_anonymous: isAnon,
      status: 'pending',
      created_at: new Date().toISOString()
    };

    // Save locally
    const saved = JSON.parse(localStorage.getItem('fullora_local_donations') || '[]');
    saved.unshift(donationData);
    localStorage.setItem('fullora_local_donations', JSON.stringify(saved));

    // Try Supabase insert
    try {
      await supabase.from('donations').insert({
        donation_mode: currentMode,
        animal_id: animalId,
        amount: amount,
        currency: 'BDT',
        payment_type: currentMethod,
        sender_wallet_or_account: sender,
        transaction_reference: trx,
        donor_name: donorName,
        donor_email: donorEmail,
        is_anonymous: isAnon,
        status: 'pending'
      });
    } catch (e) {}

    // Show celebration
    document.getElementById('wizard-step-3')?.classList.add('hidden');
    document.getElementById('wizard-celebration')?.classList.remove('hidden');

    const donorEl = document.getElementById('success-donor-name');
    const amtEl = document.getElementById('success-amount');
    const trxEl = document.getElementById('success-trx');

    if (donorEl) donorEl.textContent = donorName;
    if (amtEl) amtEl.textContent = `৳${amount.toLocaleString()} (${currentMode === 'spay_neuter' ? 'Spay/Neuter' : (currentMode === 'sponsor' ? 'Sponsorship' : 'Care & Food')})`;
    if (trxEl) trxEl.textContent = trx;

    confetti({
      particleCount: 50,
      spread: 60,
      origin: { y: 0.6 }
    });

    if (submitBtn) {
      submitBtn.removeAttribute('disabled');
      submitBtn.innerHTML = 'Complete Donation';
    }
  };
</script>
