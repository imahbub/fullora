---
import Layout from '../layouts/Layout.astro';
import ShelterMeter from '../components/ShelterMeter.astro';
import AnimalCard from '../components/AnimalCard.astro';
import WallOfHeroes from '../components/WallOfHeroes.astro';
import Icon from '../components/Icon.astro';
import { DEMO_ANIMALS } from '../lib/data.js';

// Show first 3 featured animals on homepage
const featuredAnimals = DEMO_ANIMALS.filter(a => a.is_featured).slice(0, 3);
---

<Layout title="Fullora's Shelter — Cat & Dog Rescue Sanctuary">

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-10 pb-16 lg:pt-16 lg:pb-24">
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Pill -->
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-700 mb-5">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>Community Sanctuary in Dhaka • Rescuing Dogs & Cats</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-stone-900 dark:text-white leading-[1.15]">
          A Safe Haven for Rescued <br />
          <span class="text-emerald-700 dark:text-emerald-400">
            Cats, Dogs & Whiskers
          </span>
        </h1>

        <p class="mt-4 text-sm sm:text-base text-stone-600 dark:text-stone-400 max-w-xl mx-auto leading-relaxed">
          Fullora's Shelter provides nourishing food, emergency surgeries, and high-volume spaying/neutering for abandoned and injured strays.
        </p>
      </div>

      <!-- 3 Primary Action Cards (Clean Vector Icons, Refined Layout) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-4xl mx-auto mt-10">
        
        <!-- Mode 1: Once / Monthly -->
        <div class="group relative p-5 sm:p-6 rounded-2xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs hover:border-emerald-700/50 dark:hover:border-emerald-500/50 hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center mb-3">
              <Icon name="heart" class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-stone-900 dark:text-white">Care & Food Packs</h3>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
              Funds daily chicken, rice, wet food, and parasite treatments for shelter animals.
            </p>
            <div class="mt-3 text-[11px] font-semibold text-stone-700 dark:text-stone-300">
              Starts at ৳500 • Monthly from ৳1,000
            </div>
          </div>
          <div class="mt-5 pt-3 border-t border-stone-100 dark:border-stone-800">
            <button
              onclick="window.openDonationModal({ mode: 'once' })"
              class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-stone-900 hover:bg-stone-800 dark:bg-stone-100 dark:hover:bg-white text-white dark:text-stone-900 shadow-2xs transition-all flex items-center justify-center gap-1.5"
            >
              <span>Donate Food Pack</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </button>
          </div>
        </div>

        <!-- Mode 2: Sponsor an Animal -->
        <div class="group relative p-5 sm:p-6 rounded-2xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs hover:border-emerald-700/50 dark:hover:border-emerald-500/50 hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-stone-100 dark:bg-stone-800 text-stone-700 dark:text-stone-300 flex items-center justify-center mb-3">
              <Icon name="paw" class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-stone-900 dark:text-white">Sponsor a Resident</h3>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
              Support a specific cat or dog. Receive updates and a personalized digital certificate.
            </p>
            <div class="mt-3 text-[11px] font-semibold text-stone-700 dark:text-stone-300">
              Full Month Sponsorship: ৳1,000
            </div>
          </div>
          <div class="mt-5 pt-3 border-t border-stone-100 dark:border-stone-800">
            <a
              href="/animals"
              class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-emerald-700 hover:bg-emerald-800 text-white shadow-2xs transition-all flex items-center justify-center gap-1.5"
            >
              <span>Choose a Cat or Dog</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>

        <!-- Mode 3: Spay or Neuter -->
        <div class="group relative p-5 sm:p-6 rounded-2xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-xs hover:border-amber-600/50 dark:hover:border-amber-500/50 hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 flex items-center justify-center mb-3">
              <Icon name="scissors" class="w-5 h-5" />
            </div>
            <h3 class="text-base font-bold text-stone-900 dark:text-white">Spay & Neuter Fund</h3>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
              Permanently stop the cycle of suffering. Funds 1 surgical sterilization + rabies vaccination.
            </p>
            <div class="mt-3 text-[11px] font-semibold text-amber-700 dark:text-amber-400">
              Complete Surgery: ৳1,500
            </div>
          </div>
          <div class="mt-5 pt-3 border-t border-stone-100 dark:border-stone-800">
            <button
              onclick="window.openDonationModal({ mode: 'spay_neuter', amount: 1500 })"
              class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-amber-700 hover:bg-amber-800 text-white shadow-2xs transition-all flex items-center justify-center gap-1.5"
            >
              <span>Fund Surgery (৳1,500)</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </button>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Shelter Care Meter -->
  <ShelterMeter />

  <!-- Featured Dogs & Cats -->
  <section class="py-14 sm:py-18 bg-stone-50 dark:bg-stone-950 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Sanctuary Residents</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900 dark:text-white mt-1">
            Waiting for Your Compassion
          </h2>
        </div>

        <a 
          href="/animals" 
          class="inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-stone-700 dark:text-stone-300 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors"
        >
          <span>View All Animals ({DEMO_ANIMALS.length})</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {featuredAnimals.map(animal => (
          <AnimalCard animal={animal} />
        ))}
      </div>

    </div>
  </section>

  <!-- 3-Step Flow -->
  <section class="py-14 bg-white dark:bg-stone-900 border-t border-stone-200 dark:border-stone-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-white">
          How to Donate in 3 Quick Steps
        </h2>
        <p class="mt-1.5 text-xs text-stone-500 dark:text-stone-400">
          Fast, direct, and verified with complete transparency.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="p-5 rounded-2xl bg-stone-50 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700/80">
          <div class="w-7 h-7 rounded-lg bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 font-bold text-xs flex items-center justify-center mb-3">
            1
          </div>
          <h3 class="text-sm font-bold text-stone-900 dark:text-white">Select Cause & Amount</h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-1 leading-relaxed">
            Pick general care, choose a specific rescue pet, or fund a sterilization surgery.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-stone-50 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700/80">
          <div class="w-7 h-7 rounded-lg bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 font-bold text-xs flex items-center justify-center mb-3">
            2
          </div>
          <h3 class="text-sm font-bold text-stone-900 dark:text-white">Send & Copy Reference</h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-1 leading-relaxed">
            Send Money via bKash, Nagad, Rocket, or Bank. Copy our number in 1 click and enter your TrxID.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-stone-50 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700/80">
          <div class="w-7 h-7 rounded-lg bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 font-bold text-xs flex items-center justify-center mb-3">
            3
          </div>
          <h3 class="text-sm font-bold text-stone-900 dark:text-white">Verified & Honored</h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-1 leading-relaxed">
            Your support is recorded, audited by our shelter volunteers, and celebrated on our Wall of Heroes.
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- Wall of Heroes -->
  <WallOfHeroes />

</Layout>
