---
import Layout from '../layouts/Layout.astro';
import ShelterMeter from '../components/ShelterMeter.astro';
import AnimalCard from '../components/AnimalCard.astro';
import WallOfHeroes from '../components/WallOfHeroes.astro';
import { DEMO_ANIMALS } from '../lib/data.js';

// Show first 3 featured animals on homepage
const featuredAnimals = DEMO_ANIMALS.filter(a => a.is_featured).slice(0, 3);
---

<Layout title="Fullora's Shelter — Cat & Dog Rescue Sanctuary">

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-28">
    
    <!-- Calming Background Glows -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-emerald-100/40 via-teal-50/20 to-transparent dark:from-emerald-950/20 dark:via-teal-950/10 dark:to-transparent pointer-events-none -z-10 blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Pill -->
      <div class="text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-xs mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Open Sanctuary in Dhaka • Rescuing Cats & Dogs</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-stone-900 dark:text-white max-w-4xl mx-auto leading-[1.15]">
          A Safe Haven for Rescued <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-600 to-amber-600">
            Cats, Dogs & Whiskers
          </span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-stone-600 dark:text-stone-300 max-w-2xl mx-auto leading-relaxed">
          Fullora's Shelter provides food, urgent veterinary surgeries, and dedicated spay/neuter operations for abandoned and injured strays. 
          Every donation directly saves a life.
        </p>
      </div>

      <!-- 3 Primary Donation Mode Cards (Gamified Entrypoints) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mt-12">
        
        <!-- Mode 1: Once / Monthly -->
        <div class="group relative p-6 sm:p-7 rounded-3xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-sm hover:shadow-xl hover:border-emerald-500/50 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
              💖
            </div>
            <h3 class="text-lg font-bold text-stone-900 dark:text-white">Once / Monthly Care</h3>
            <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-2 leading-relaxed">
              Help us buy rice, meat, wet food, flea medicine, and keep shelter blankets warm.
            </p>
            <div class="mt-4 text-xs font-semibold text-emerald-700 dark:text-emerald-400">
              Starts at ৳500 • Monthly from ৳1,000
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-stone-100 dark:border-stone-800">
            <button
              onclick="window.openDonationModal({ mode: 'once' })"
              class="w-full py-2.5 px-4 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs transition-all flex items-center justify-center gap-1.5"
            >
              <span>Donate Care Pack</span>
              <span>&rarr;</span>
            </button>
          </div>
        </div>

        <!-- Mode 2: Sponsor an Animal -->
        <div class="group relative p-6 sm:p-7 rounded-3xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-sm hover:shadow-xl hover:border-teal-500/50 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
              🌟
            </div>
            <h3 class="text-lg font-bold text-stone-900 dark:text-white">Sponsor an Animal</h3>
            <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-2 leading-relaxed">
              Select a specific rescue cat or dog. Receive updates and a downloadable Digital Adoption Certificate.
            </p>
            <div class="mt-4 text-xs font-semibold text-teal-700 dark:text-teal-400">
              Full Month Sponsorship: ৳1,000
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-stone-100 dark:border-stone-800">
            <a
              href="/animals"
              class="w-full py-2.5 px-4 rounded-xl text-xs font-bold bg-teal-600 hover:bg-teal-700 text-white shadow-xs transition-all flex items-center justify-center gap-1.5"
            >
              <span>Choose Cat or Dog</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Mode 3: Spay or Neuter -->
        <div class="group relative p-6 sm:p-7 rounded-3xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-sm hover:shadow-xl hover:border-amber-500/50 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center text-2xl mb-4 group-hover:scale-110 transition-transform">
              ✂️
            </div>
            <h3 class="text-lg font-bold text-stone-900 dark:text-white">Spay or Neuter Fund</h3>
            <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-2 leading-relaxed">
              Directly stop suffering and homeless stray overpopulation. Funds one complete sterilization surgery.
            </p>
            <div class="mt-4 text-xs font-semibold text-amber-700 dark:text-amber-400">
              1 Surgery + Rabies Shot: ৳1,500
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-stone-100 dark:border-stone-800">
            <button
              onclick="window.openDonationModal({ mode: 'spay_neuter', amount: 1500 })"
              class="w-full py-2.5 px-4 rounded-xl text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white shadow-xs transition-all flex items-center justify-center gap-1.5"
            >
              <span>Fund Surgery (৳1,500)</span>
              <span>&rarr;</span>
            </button>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Gamified Shelter Care Meter Component -->
  <ShelterMeter />

  <!-- Featured Cats and Dogs Section -->
  <section class="py-16 sm:py-20 bg-stone-50 dark:bg-stone-950 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider mb-2">
            <span>🐾 Meet The Residents</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-white">
            Dogs & Cats Waiting For Your Love
          </h2>
        </div>

        <a 
          href="/animals" 
          class="inline-flex items-center gap-1.5 text-sm font-bold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 hover:underline"
        >
          <span>View All Shelter Animals</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredAnimals.map(animal => (
          <AnimalCard animal={animal} />
        ))}
      </div>

    </div>
  </section>

  <!-- Transparent 3-Step Process -->
  <section class="py-16 bg-white dark:bg-stone-900 border-t border-stone-200 dark:border-stone-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-white">
          How Donating Works in 3 Simple Steps
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-stone-600 dark:text-stone-400">
          Fast, transparent, and respectful of your privacy.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        
        <div class="text-center p-5 rounded-2xl bg-stone-50 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700">
          <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 font-black text-sm flex items-center justify-center mx-auto mb-3">
            1
          </div>
          <h3 class="text-sm font-bold text-stone-900 dark:text-white">Choose Your Cause</h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
            Pick a one-time meal pack, sponsor a specific cat or dog, or fund a spay/neuter surgery.
          </p>
        </div>

        <div class="text-center p-5 rounded-2xl bg-stone-50 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700">
          <div class="w-10 h-10 rounded-full bg-teal-100 dark:bg-teal-950/80 text-teal-700 dark:text-teal-300 font-black text-sm flex items-center justify-center mx-auto mb-3">
            2
          </div>
          <h3 class="text-sm font-bold text-stone-900 dark:text-white">Send Money & Copy TrxID</h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
            Use bKash, Nagad, Rocket, or direct Bank transfer. Copy our number in 1-click and paste your TrxID.
          </p>
        </div>

        <div class="text-center p-5 rounded-2xl bg-stone-50 dark:bg-stone-800/50 border border-stone-200 dark:border-stone-700">
          <div class="w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 font-black text-sm flex items-center justify-center mx-auto mb-3">
            3
          </div>
          <h3 class="text-sm font-bold text-stone-900 dark:text-white">Get Badges & Impact</h3>
          <p class="text-xs text-stone-500 dark:text-stone-400 mt-1.5 leading-relaxed">
            Receive your digital badge, celebrate on the Wall of Heroes, or stay completely anonymous!
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Wall of Heroes -->
  <WallOfHeroes />

</Layout>
