---
import Layout from '../layouts/Layout.astro';
import AnimalCard from '../components/AnimalCard.astro';
import { DEMO_ANIMALS } from '../lib/data.js';
---

<Layout title="Meet Our Dogs & Cats — Fullora's Shelter">

  <section class="py-12 sm:py-16 bg-white dark:bg-stone-900 border-b border-stone-200 dark:border-stone-800 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 mb-4">
        <span>🐾 Resident Directory</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-stone-900 dark:text-white tracking-tight">
        Our Rescued Cats & Dogs
      </h1>
      <p class="mt-3 text-sm sm:text-base text-stone-600 dark:text-stone-400 max-w-2xl mx-auto">
        Each one has a story of resilience. You can sponsor their monthly food and care, or fund urgent spaying and neutering surgery.
      </p>

      <!-- Filter Controls & Search -->
      <div class="mt-8 max-w-3xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        
        <!-- Filter Tabs -->
        <div class="flex flex-wrap items-center justify-center gap-2" id="filter-buttons">
          <button 
            type="button" 
            onclick="window.filterAnimals('all')" 
            class="filter-tab px-4 py-2 rounded-xl text-xs font-bold border border-emerald-600 bg-emerald-50 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 transition-all"
            data-filter="all"
          >
            All Animals ({DEMO_ANIMALS.length})
          </button>
          <button 
            type="button" 
            onclick="window.filterAnimals('cat')" 
            class="filter-tab px-4 py-2 rounded-xl text-xs font-bold border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:border-emerald-500 transition-all"
            data-filter="cat"
          >
            🐱 Cats ({DEMO_ANIMALS.filter(a => a.species === 'cat').length})
          </button>
          <button 
            type="button" 
            onclick="window.filterAnimals('dog')" 
            class="filter-tab px-4 py-2 rounded-xl text-xs font-bold border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:border-emerald-500 transition-all"
            data-filter="dog"
          >
            🐶 Dogs ({DEMO_ANIMALS.filter(a => a.species === 'dog').length})
          </button>
          <button 
            type="button" 
            onclick="window.filterAnimals('needs_spay')" 
            class="filter-tab px-4 py-2 rounded-xl text-xs font-bold border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-600 dark:text-stone-300 hover:border-amber-500 transition-all"
            data-filter="needs_spay"
          >
            ✂️ Needs Spaying
          </button>
        </div>

        <!-- Search Input -->
        <div class="relative w-full sm:w-64">
          <span class="absolute left-3.5 top-2.5 text-stone-400 text-xs">🔍</span>
          <input 
            type="text" 
            id="animal-search" 
            placeholder="Search by name..." 
            oninput="window.searchAnimals(this.value)"
            class="w-full pl-9 pr-4 py-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-xs text-stone-900 dark:text-white focus:ring-2 focus:ring-emerald-500 outline-hidden"
          />
        </div>

      </div>

    </div>
  </section>

  <!-- Animals Grid -->
  <section class="py-12 sm:py-16 bg-stone-50 dark:bg-stone-950 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div id="animals-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {DEMO_ANIMALS.map(animal => (
          <div 
            class="animal-item" 
            data-species={animal.species} 
            data-needs-spay={animal.needs_spay_neuter ? 'true' : 'false'}
            data-name={animal.name.toLowerCase()}
          >
            <AnimalCard animal={animal} />
          </div>
        ))}
      </div>

      <!-- No Results State -->
      <div id="no-animals-msg" class="hidden text-center py-16">
        <div class="text-4xl mb-3">🐾</div>
        <h3 class="text-lg font-bold text-stone-900 dark:text-white">No animals matched your search</h3>
        <p class="text-xs text-stone-500 dark:text-stone-400 mt-1">Try clearing your filters or search term.</p>
        <button 
          onclick="window.filterAnimals('all')"
          class="mt-4 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white"
        >
          Reset Filters
        </button>
      </div>

    </div>
  </section>

</Layout>

<script is:inline>
  let activeFilter = 'all';
  let searchTerm = '';

  window.filterAnimals = function(filter) {
    activeFilter = filter;
    
    // Update tab styling
    document.querySelectorAll('.filter-tab').forEach(tab => {
      if (tab.getAttribute('data-filter') === filter) {
        tab.classList.add('border-emerald-600', 'bg-emerald-50', 'dark:bg-emerald-950/80', 'text-emerald-800', 'dark:text-emerald-300');
        tab.classList.remove('border-stone-200', 'dark:border-stone-700', 'bg-stone-50', 'dark:bg-stone-800', 'text-stone-600', 'dark:text-stone-300');
      } else {
        tab.classList.remove('border-emerald-600', 'bg-emerald-50', 'dark:bg-emerald-950/80', 'text-emerald-800', 'dark:text-emerald-300');
        tab.classList.add('border-stone-200', 'dark:border-stone-700', 'bg-stone-50', 'dark:bg-stone-800', 'text-stone-600', 'dark:text-stone-300');
      }
    });

    applyFilters();
  };

  window.searchAnimals = function(term) {
    searchTerm = term.toLowerCase().trim();
    applyFilters();
  };

  function applyFilters() {
    const items = document.querySelectorAll('.animal-item');
    let visibleCount = 0;

    items.forEach(item => {
      const species = item.getAttribute('data-species');
      const needsSpay = item.getAttribute('data-needs-spay') === 'true';
      const name = item.getAttribute('data-name') || '';

      let matchesFilter = true;
      if (activeFilter === 'cat' && species !== 'cat') matchesFilter = false;
      if (activeFilter === 'dog' && species !== 'dog') matchesFilter = false;
      if (activeFilter === 'needs_spay' && !needsSpay) matchesFilter = false;

      let matchesSearch = true;
      if (searchTerm && !name.includes(searchTerm)) matchesSearch = false;

      if (matchesFilter && matchesSearch) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    const noMsg = document.getElementById('no-animals-msg');
    if (visibleCount === 0) {
      noMsg?.classList.remove('hidden');
    } else {
      noMsg?.classList.add('hidden');
    }
  }

  // Sync client-side additions/edits/deletions from Admin panel
  function syncClientAnimals() {
    try {
      const deletedIds = new Set(JSON.parse(localStorage.getItem('fullora_deleted_animals') || '[]'));
      const local = JSON.parse(localStorage.getItem('fullora_local_animals') || '[]');
      
      const grid = document.getElementById('animals-grid');
      if (!grid) return;

      // Hide deleted default animals
      deletedIds.forEach(id => {
        const el = document.querySelector(`button[onclick*="${id}"]`)?.closest('.animal-item');
        el?.remove();
      });

      // Prepend or update local animals
      if (local.length > 0) {
        local.forEach(a => {
          // Remove if already in DOM (e.g. edited demo pet)
          const existing = document.querySelector(`button[onclick*="${a.id}"]`)?.closest('.animal-item');
          if (existing) existing.remove();

          const cardWrapper = document.createElement('div');
          cardWrapper.className = 'animal-item';
          cardWrapper.setAttribute('data-species', a.species);
          cardWrapper.setAttribute('data-needs-spay', a.needs_spay_neuter ? 'true' : 'false');
          cardWrapper.setAttribute('data-name', a.name.toLowerCase());

          const isCat = a.species === 'cat';
          const sponsorshipPercent = Math.min(100, Math.round(((a.current_sponsorship_funded || 0) / (a.monthly_sponsorship_goal || 1000)) * 100));

          cardWrapper.innerHTML = `
            <div class="group flex flex-col rounded-3xl overflow-hidden bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-sm hover:shadow-md hover:border-emerald-500/40 transition-all duration-300">
              <div class="relative w-full h-56 sm:h-64 overflow-hidden bg-stone-100 dark:bg-stone-800">
                <img src="${a.image_url || 'https://images.unsplash.com/photo-1543466835-00a7907e9de1?auto=format&fit=crop&w=800&q=80'}" alt="${a.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-stone-950/70 via-transparent to-transparent"></div>
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-white/95 dark:bg-stone-900/95 text-stone-900 dark:text-stone-100 shadow-xs">
                    <span>${isCat ? '🐱' : '🐶'}</span>
                    <span class="capitalize">${a.species}</span>
                  </span>
                  ${a.needs_spay_neuter ? '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500 text-stone-950 shadow-xs animate-pulse"><span>✂️</span><span>Needs Spaying</span></span>' : ''}
                </div>
                <div class="absolute bottom-3 left-4 right-4">
                  <h3 class="text-xl font-bold text-white tracking-tight drop-shadow-sm flex items-center justify-between">
                    <span>${a.name}</span>
                    <span class="text-xs font-medium px-2 py-0.5 rounded-md bg-stone-900/60 text-stone-200">${a.age || 'Young'}</span>
                  </h3>
                </div>
              </div>
              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed line-clamp-3">${a.story || 'Rescue resident.'}</p>
                  <div class="mt-4 pt-4 border-t border-stone-100 dark:border-stone-800/80">
                    <div class="flex items-center justify-between text-xs font-medium text-stone-500 dark:text-stone-400 mb-1.5">
                      <span>Monthly Care Goal</span>
                      <span class="font-semibold text-stone-900 dark:text-stone-200">৳${(a.current_sponsorship_funded || 0).toLocaleString()} / ৳${(a.monthly_sponsorship_goal || 1000).toLocaleString()}</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-stone-100 dark:bg-stone-800 overflow-hidden">
                      <div class="h-full bg-emerald-500 rounded-full" style="width: ${sponsorshipPercent}%"></div>
                    </div>
                  </div>
                </div>
                <div class="mt-5 pt-3 grid grid-cols-1 gap-2">
                  <button onclick="window.openDonationModal({ mode: 'sponsor', animalId: '${a.id}', animalName: '${a.name}', amount: ${a.monthly_sponsorship_goal || 1000} })" class="w-full py-2.5 px-4 rounded-xl text-xs sm:text-sm font-semibold bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center gap-1.5 transition-all">
                    <span>🌟 Sponsor ${a.name} (৳${(a.monthly_sponsorship_goal || 1000).toLocaleString()}/mo)</span>
                  </button>
                  ${a.needs_spay_neuter ? `<button onclick="window.openDonationModal({ mode: 'spay_neuter', animalId: '${a.id}', animalName: '${a.name}', amount: ${a.spay_neuter_cost || 1500} })" class="w-full py-2 px-4 rounded-xl text-xs sm:text-sm font-semibold bg-amber-500/15 hover:bg-amber-500/25 text-amber-900 dark:text-amber-200 border border-amber-300 dark:border-amber-700 flex items-center justify-center gap-1.5"><span>✂️ Fund ${a.name}'s Surgery (৳${(a.spay_neuter_cost || 1500).toLocaleString()})</span></button>` : ''}
                </div>
              </div>
            </div>
          `;
          grid.prepend(cardWrapper);
        });
      }
    } catch (e) {}
  }

  syncClientAnimals();
</script>
